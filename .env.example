PORT=3000
# Local development uses loopback. Render should set HOST=0.0.0.0.
HOST=127.0.0.1
# Set AUTH_MODE=github only for the hosted backend.
AUTH_MODE=local
FRONTEND_ORIGIN=http://127.0.0.1:3000
# Hosted backend origin, for example https://japanese-vocab-copilot.onrender.com
# PUBLIC_BASE_URL=
# Required when AUTH_MODE=github.
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# ALLOWED_GITHUB_LOGIN=jerryleung16
# SESSION_SECRET=replace-with-a-long-random-value
AUTH_SESSION_TTL_MS=604800000
MAX_BODY_LENGTH=16000
MAX_MESSAGE_LENGTH=1000
MAX_SESSION_NAME_LENGTH=80
MAX_CONTEXT_LENGTH=4000
MAX_CONCURRENT_TURNS=2
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_LIMIT=30
SESSION_IDLE_TIMEOUT_MS=1800000
TURN_TIMEOUT_MS=45000
# Optional: set a model supported by your Copilot account.
# COPILOT_MODEL=